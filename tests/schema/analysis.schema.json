{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NetTapAnalysisReport",
  "description": "Schema for net-tap JSON analysis output",
  "type": "object",
  "required": [
    "vlans",
    "qinq_frames",
    "mac_addresses",
    "ipv4_addresses",
    "ipv4_gateways",
    "ipv6_addresses",
    "ipv6_prefixes",
    "ipv6_routers",
    "resolution",
    "tunnels",
    "protocols",
    "infrastructure_frames",
    "security_frames",
    "dpi",
    "top_talkers"
  ],
  "properties": {
    "vlans": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^([0-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|409[0-5])$" }
    },
    "qinq_frames": {
      "type": "integer",
      "minimum": 0
    },
    "mac_addresses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$" }
    },
    "ipv4_addresses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "ipv4" }
    },
    "ipv4_gateways": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "ipv4" }
    },
    "ipv6_addresses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "ipv6" }
    },
    "ipv6_prefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^([0-9a-fA-F]{0,4}:){1,7}[0-9a-fA-F]{0,4}/(12[0-8]|1[0-1][0-9]|[1-9][0-9]?|0)$" }
    },
    "ipv6_routers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "ipv6" }
    },
    "resolution": {
      "type": "object",
      "required": ["arp_frames", "ndp_frames", "ndp_details"],
      "properties": {
        "arp_frames": { "type": "integer", "minimum": 0 },
        "ndp_frames": { "type": "integer", "minimum": 0 },
        "ndp_details": {
          "type": "object",
          "required": [
            "neighbor_solicitation",
            "neighbor_advertisement",
            "router_solicitation",
            "router_advertisement",
            "redirect"
          ],
          "properties": {
            "neighbor_solicitation": { "type": "integer", "minimum": 0 },
            "neighbor_advertisement": { "type": "integer", "minimum": 0 },
            "router_solicitation": { "type": "integer", "minimum": 0 },
            "router_advertisement": { "type": "integer", "minimum": 0 },
            "redirect": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tunnels": {
      "type": "object",
      "required": ["vxlan", "gtp_u", "gtp_c", "geneve", "gre", "mpls", "six_in_four", "four_in_six", "srv6"],
      "properties": {
        "vxlan": { "type": "integer", "minimum": 0 },
        "gtp_u": { "type": "integer", "minimum": 0 },
        "gtp_c": { "type": "integer", "minimum": 0 },
        "geneve": { "type": "integer", "minimum": 0 },
        "gre": { "type": "integer", "minimum": 0 },
        "mpls": { "type": "integer", "minimum": 0 },
        "six_in_four": { "type": "integer", "minimum": 0 },
        "four_in_six": { "type": "integer", "minimum": 0 },
        "srv6": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "protocols": {
      "type": "object",
      "required": ["sctp", "pmtud", "ipv6_extension_headers", "tcp_options", "tcp_flags"],
      "properties": {
        "sctp": { "type": "integer", "minimum": 0 },
        "pmtud": { "type": "integer", "minimum": 0 },
        "ipv6_extension_headers": {
          "type": "object",
          "required": [
            "hop_by_hop",
            "routing",
            "fragment",
            "esp",
            "ah"
          ],
          "properties": {
            "hop_by_hop": { "type": "integer", "minimum": 0 },
            "routing": { "type": "integer", "minimum": 0 },
            "fragment": { "type": "integer", "minimum": 0 },
            "esp": { "type": "integer", "minimum": 0 },
            "ah": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "tcp_options": {
          "type": "object",
          "required": [
            "mss",
            "wscale",
            "sack_permitted",
            "out_of_order"
          ],
          "properties": {
            "mss": { "type": "integer", "minimum": 0 },
            "wscale": { "type": "integer", "minimum": 0 },
            "sack_permitted": { "type": "integer", "minimum": 0 },
            "out_of_order": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "tcp_flags": {
          "type": "object",
          "required": [
            "syn",
            "syn_ack",
            "rst",
            "fin",
            "psh",
            "urg",
            "zero_window",
            "retransmission"
          ],
          "properties": {
            "syn": { "type": "integer", "minimum": 0 },
            "syn_ack": { "type": "integer", "minimum": 0 },
            "rst": { "type": "integer", "minimum": 0 },
            "fin": { "type": "integer", "minimum": 0 },
            "psh": { "type": "integer", "minimum": 0 },
            "urg": { "type": "integer", "minimum": 0 },
            "zero_window": { "type": "integer", "minimum": 0 },
            "retransmission": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "infrastructure_frames": {
      "type": "object",
      "required": ["lldp", "cdp", "stp", "vrrp", "hsrp", "isis", "bfd"],
      "properties": {
        "lldp": { "type": "integer", "minimum": 0 },
        "cdp": { "type": "integer", "minimum": 0 },
        "stp": { "type": "integer", "minimum": 0 },
        "vrrp": { "type": "integer", "minimum": 0 },
        "hsrp": { "type": "integer", "minimum": 0 },
        "isis": { "type": "integer", "minimum": 0 },
        "bfd": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "security_frames": {
      "type": "object",
      "required": ["eapol", "dhcp"],
      "properties": {
        "eapol": { "type": "integer", "minimum": 0 },
        "dhcp": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "dpi": {
      "type": "object",
      "required": [
        "snmp_community_strings",
        "ospf_routers",
        "bgp_asns",
        "dhcp_hostnames",
        "dns_queries",
        "tls_sni"
      ],
      "properties": {
        "snmp_community_strings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 256 }
        },
        "ospf_routers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "ipv4" }
        },
        "bgp_asns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$" }
        },
        "dhcp_hostnames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 253 }
        },
        "dns_queries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 253 }
        },
        "tls_sni": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 253 }
        }
      },
      "additionalProperties": false
    },
    "top_talkers": {
      "type": "object",
      "required": ["ipv4", "ipv6", "flows"],
      "properties": {
        "ipv4": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ip", "packets"],
            "properties": {
              "ip": { "type": "string", "format": "ipv4" },
              "packets": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "ipv6": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ip", "packets"],
            "properties": {
              "ip": { "type": "string", "format": "ipv6" },
              "packets": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["flow", "packets"],
            "properties": {
              "flow": { "type": "string" },
              "packets": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "active_audit": {
      "type": "object",
      "required": ["audit_files", "probes_sent", "responses_received", "vlans_probed", "discovered_hosts"],
      "properties": {
        "audit_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "probes_sent": { "type": "integer", "minimum": 0 },
        "responses_received": { "type": "integer", "minimum": 0 },
        "vlans_probed": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(untagged|[0-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|409[0-5])$" }
        },
        "discovered_hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ip", "mac", "vlan"],
            "properties": {
              "ip": {
                "type": "string",
                "oneOf": [
                  { "format": "ipv4" },
                  { "format": "ipv6" }
                ]
              },
              "mac": { "type": "string", "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$" },
              "vlan": { "type": "string", "pattern": "^(untagged|[0-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|409[0-5])$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
